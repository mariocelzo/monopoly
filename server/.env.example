# Porta di ascolto. Su Render viene impostata dalla piattaforma.
PORT=3001

# Origini del client ammesse dal CORS, separate da virgola.
# Vuoto in locale = tutte ammesse.
# In produzione, per esempio:
# CLIENT_ORIGIN=https://noi-due-monopoly.vercel.app,https://noi-due-monopoly-git-main-mario.vercel.app
CLIENT_ORIGIN=

# ---------------------------------------------------------------------------
# Persistenza delle partite. Spenta se restano vuote TUTTE E DUE le variabili
# qui sotto: lo stato vive solo in memoria, nessun file, nessuna connessione.
# È il comportamento voluto in locale — non c'è niente da installare né da far
# girare per sviluppare o per lanciare i test.
#
# Se sono impostate entrambe vince REDIS_URL e il file viene ignorato (il
# server lo scrive nel registro all'avvio).
# ---------------------------------------------------------------------------

# ARCHIVIO ESTERNO (quello da usare in produzione). Un Redis qualunque
# raggiungibile via URL: va bene un'istanza gratuita di Upstash, un Redis
# gestito, o un container in locale. Sopravvive al riavvio del processo E al
# deploy, perché sta fuori dal container: è l'unico dei due che salva le
# partite in corso quando si pubblica una versione nuova su Render.
#
# Per provarlo in locale:  docker run --rm -p 6379:6379 redis
# REDIS_URL=redis://127.0.0.1:6379
#
# Con un servizio gestito l'URL arriva già fatto e usa TLS (`rediss://`). La
# password sta dentro l'URL, quindi è un segreto: non va committato, si imposta
# fra le variabili d'ambiente del servizio (su Render: Environment).
# REDIS_URL=rediss://default:LA-PASSWORD@nome-istanza.upstash.io:6379
REDIS_URL=

# ARCHIVIO SU FILE (ripiego). Percorso del file su cui salvare lo stato delle
# partite. Utile in locale, o su un host con un disco vero che sopravviva ai
# riavvii.
#
# ATTENZIONE su Render piano gratuito: il filesystem è effimero e viene
# ricreato a ogni deploy e a ogni riavvio dell'istanza. Questa variabile
# protegge da un crash o un riavvio "sul posto" (qui in locale, oppure su un
# host con un disco vero), NON da un nuovo deploy su Render: il file scritto
# prima del deploy semplicemente non c'è più dopo. In produzione si usa
# REDIS_URL. Vedi il README per i dettagli.
#
# PERSIST_FILE=./data/rooms-state.json
PERSIST_FILE=
